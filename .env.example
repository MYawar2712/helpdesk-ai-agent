# Copy this file to .env and replace the placeholder with your rotated key.
LLM_API_KEY="API KEY"
LLM_MODEL=qwen3.8-omni-flash
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_MAX_OUTPUT_TOKENS=512
LLM_TIMEOUT=3

# ── Day 23: LangSmith tracing ─────────────────────────────────────────────
# Get your API key from https://smith.langchain.com/ → Settings → API Keys
# Never commit real keys; copy this file to .env.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=YOUR_LANGSMITH_API_KEY_HERE
LANGCHAIN_PROJECT=helpdesk-ai-agent
# LANGSMITH_TRACING / LANGSMITH_API_KEY / LANGSMITH_PROJECT are also accepted.

# -- Conversation memory ----------------------------------------------------
# Maximum number of prior conversation messages injected into the LLM prompt.
# Increase for richer context; decrease to reduce token usage.
CONVERSATION_HISTORY_LIMIT=20

# -- Day 6: persistent LangGraph checkpoints --------------------------------
# Optional. For PostgreSQL, this defaults to DATABASE_URL. For SQLite, the
# default is a separate file at db/langgraph_checkpoints.sqlite3.
# LANGGRAPH_DATABASE_URL=postgresql://user:password@localhost:5432/helpdesk_db
# LANGGRAPH_SQLITE_PATH=db/langgraph_checkpoints.sqlite3
